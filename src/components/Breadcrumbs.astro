---
interface ExtraPath {
  title: string;
  link: string;
}

interface Props {
  destination: string;
  'extra-path'?: ExtraPath;
}

const { destination, 'extra-path': extraPath } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Categorii</a>

  {
    extraPath && (
      <>
        <span class="separator">→</span>
        <a href={extraPath.link}>{extraPath.title}</a>
      </>
    )
  }

  <span class="separator">→</span>
  <span class="current">{destination}</span>
</nav>

<style>
  :root {
    --accent-gold: #c5a059;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #6b7280;
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--accent-gold);
  }

  .breadcrumb .separator {
    color: #9ca3af;
    font-size: 0.75rem;
  }

  .breadcrumb .current {
    color: #374151;
    font-weight: 500;
  }
</style>
