---
import Baselayout from '../layouts/Baselayout.astro';
import CardContainer from '../components/CardContainer.astro';

const categoryFiles = import.meta.glob<{category_name: string, image: string}>('../../data/categories/*.json', {eager: true});

const categories = Object.entries(categoryFiles).map(([path, category]) => ({
  title: category.category_name,
  image: category.image,
  link: path.split('/').pop()?.replace('.json', '') ?? ''
}));
---

<Baselayout pageTitle="Elvida Stone">
  <>
    <img src="/images/static/bkgPlaceholder.jpeg" />
    <h1>Elvida Stone - Onoram memoria cu eleganta</h1>
    <h2>Importatori direcți de piatră naturală premium de o calitate excepțională</h2>
    <CardContainer items={categories} title='Categoriile noastre' />
    <div class="vertical-split" />
  </>
</Baselayout>

<style>
img {
  position: absolute;
  width: 100%;
  min-height: 25em;
  z-index: 0;
  object-fit: cover;
}
h1, h2 {
  position: relative;
  color: white;
  z-index: 1;
  text-align: center;
  font-family: serif;
  font-weight: 100;
  text-shadow: 0 0 10px black;
}
h1 {
  font-size: 3em;
  margin-top: 1.7em;
  margin-bottom: 0.5em;
}
h2 {
  margin-top: 1em;
  margin-bottom: 2em;
}
.vertical-split {
  position: relative;
  height: 2.5px;
  width: 88%;
  margin: auto;
  margin-top: 0.7em;
  border-radius: 2px;
  background: linear-gradient(180deg, #d4af37 0%, #e2cb55 100%);
  z-index: 1;
}
</style>
