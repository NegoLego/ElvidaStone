---
import Baselayout from '../layouts/Baselayout.astro';
import CardContainer from '../components/CardContainer.astro';

const categoryFiles = import.meta.glob<{category_name: string, image: string}>('../../data/categories/*.json', {eager: true});

const categories = Object.entries(categoryFiles).map(([path, category]) => ({
  title: category.category_name,
  image: category.image,
  link: path.split('/').pop()?.replace('.json', '') ?? ''
}));
---

<Baselayout pageTitle="Elvida Stone">
  <>
    <img src="/images/static/bkgPlaceholder.jpeg" />
    <h1>Elvida Stone - Onoram memoria cu eleganta</h1>
    <CardContainer items={categories} title='Categoriile noastre' />
  </>
</Baselayout>

<style>
img {
  position: absolute;
  width: 100%;
  min-height: 25em;
  z-index: 0;
  object-fit: cover;
}
h1 {
  position: relative;
  color: white;
  z-index: 1;
  margin: 3em;
  text-align: center;
  font-family: serif;
  font-weight: 100;
  text-shadow: 0 0 10px black;
}
</style>
